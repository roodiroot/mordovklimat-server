{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "square": {
      "type": "string"
    },
    "compressor": {
      "type": "string"
    },
    "wifi": {
      "type": "string"
    },
    "price": {
      "type": "biginteger"
    },
    "brand": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::brand.brand",
      "inversedBy": "products"
    },
    "description": {
      "type": "richtext"
    },
    "btu_capacity": {
      "type": "string"
    },
    "refrigerant_type": {
      "type": "string"
    },
    "cooling_power": {
      "type": "string"
    },
    "heating_power": {
      "type": "string"
    },
    "operation_modes": {
      "type": "string"
    },
    "min_noise_level": {
      "type": "string"
    },
    "series": {
      "type": "string"
    },
    "max_line_length": {
      "type": "string"
    },
    "caracteristic": {
      "type": "component",
      "repeatable": true,
      "component": "characteristic.characteristic"
    },
    "description_short": {
      "type": "richtext"
    },
    "old_price": {
      "type": "biginteger"
    }
  }
}
